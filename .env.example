# Copy this file to .env and add your key. Never commit .env.

# Required. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional settings. The values shown are the defaults.
MODEL_NAME=groq:qwen/qwen3.8-27b
TEMPERATURE=0.7
MAX_TOKENS=1024
SYSTEM_PROMPT=You are a helpful, friendly assistant. Answer clearly and concisely, and use Markdown when formatting makes the answer easier to read.
MAX_HISTORY_MESSAGES=7
REQUEST_TIMEOUT_S=60
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO
